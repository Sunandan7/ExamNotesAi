# MongoDB Connection String
MONGODB_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/examnoteAI"

# JWT Secret Key (generate a long random string)
JWT_SECRET="your_jwt_secret_key_here"

# Google Gemini API Key (get from https://aistudio.google.com/app/apikeys)
GEMINI_API_KEY="your_gemini_api_key_here"

# Stripe Secret Key (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret (get from https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Client URL
CLIENT_URL=http://localhost:5173

# Server Port
PORT=5000
